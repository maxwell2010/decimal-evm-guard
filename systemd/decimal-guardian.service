[Unit]
Description=Decimal EVM validator signature guard
After=network-online.target decimal.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/decimal-guardian/venv/bin/decimal-guardian guard
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/decimal-guardian
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
